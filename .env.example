# OpenRouter (LLM intent processing)
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# OpenAI (Whisper STT + TTS)
OPENAI_API_KEY=your-openai-key-here
STT_MODEL=gpt-4o-mini-transcribe
TTS_MODEL=tts-1
TTS_VOICE=alloy

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Comma-separated list of allowed chat IDs
TELEGRAM_CHAT_IDS=your-telegram-chat-id

# IR (adjust after checking /dev/lirc* on your Pi)
IR_DEVICE_SEND=/dev/lirc0
IR_DEVICE_RECEIVE=/dev/lirc1

# Wake word detection
WAKE_WORD_MODEL=hey_jarvis_v0.1
# Threshold applies to the verifier probability when a verifier is set
WAKE_WORD_THRESHOLD=0.5
WAKE_WORD_COOLDOWN=5.0
# Consecutive frames above threshold required (filters single-frame spikes)
WAKE_WORD_PATIENCE=2
# Path to a custom verifier .pkl (see scripts/train_verifier.py); empty disables
WAKE_WORD_VERIFIER_MODEL=
WAKE_WORD_VERIFIER_THRESHOLD=0.3

# Audio levels (percent)
# Mic gain; wake word verifier training clips must match this level
MIC_VOLUME_PERCENT=250
# Master output volume: cap for volume commands, and level set at startup
MAX_VOLUME_PERCENT=80
STARTUP_VOLUME_PERCENT=60
# TTS/chime stream volume relative to master (100 = unchanged)
TTS_VOLUME_PERCENT=100

# Voice response routing
VOICE_RESPONSE_TELEGRAM=true
VOICE_RESPONSE_TTS=true

# Spotify
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback
SPOTIFY_DEVICE_NAME=clawdia
# Multi-user: chat_id:cache[:client_id:secret],...
SPOTIFY_USERS=

# PC Remote Control
PC_SSH_HOST=
PC_SSH_USER=
PC_SSH_KEY_PATH=~/.ssh/id_ed25519
PC_AGENT_PATH=~/clawdia-agent

# Debug
DEBUG=false
